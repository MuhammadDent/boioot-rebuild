modules = ["nodejs-24", "dotnet-8.0", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["sh", "-c", "bash boioot/run-prod.sh"]
build = ["sh", "-c", "bash boioot/build-prod.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prod-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Boioot .NET API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Boioot Frontend"

[[workflows.workflow]]
name = "prod-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash boioot/build-prod.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Boioot .NET API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash boioot/apps/backend/run-api.sh"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Boioot Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd boioot/apps/frontend && pnpm dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["flyctl", "dig", "nano", "nmap"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]
NEXT_PUBLIC_GTM_ID = "GTM-kdjfvuyf"
